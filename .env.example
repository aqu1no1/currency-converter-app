# Copie para .env.beta (desenvolvimento, `pnpm start:beta`) e .env.production (`pnpm start`).
# URL da currency-converter-api. Use o IP da máquina na rede: o celular não acessa localhost.
# Tudo que começa com EXPO_PUBLIC_ fica visível no app, então nada secreto aqui.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
