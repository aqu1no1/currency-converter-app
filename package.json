{
  "name": "currency-converter-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=production expo start",
    "start:beta": "APP_VARIANT=beta expo start",
    "start:tunnel": "APP_VARIANT=beta expo start --tunnel",
    "start:clear": "APP_VARIANT=beta expo start --clear",
    "android": "APP_VARIANT=production expo start --android",
    "android:beta": "APP_VARIANT=beta expo start --android",
    "ios": "APP_VARIANT=production expo start --ios",
    "ios:beta": "APP_VARIANT=beta expo start --ios",
    "web": "APP_VARIANT=production expo start --web",
    "web:beta": "APP_VARIANT=beta expo start --web",
    "lint": "oxlint --type-aware --deny-warnings src/ test/ types/",
    "lint:fix": "oxlint --fix --type-aware src/ test/ types/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "doctor": "expo-doctor",
    "pr": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:cov && pnpm run doctor"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "decimal.js": "^10.6.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "dotenv": "^18.0.5",
    "expo-doctor": "^1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.4.2"
}
